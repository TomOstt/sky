# bench: N=1000000 quick=1000
# A scalar kernel that writes the same subexpressions in different blocks:
# `x * y` and `a * b + x * y` in the condition, in both arms of the `if` and
# after it, and `a * b`, which never changes, everywhere. The e-graph merges
# equal expressions only inside one straight-line segment; `gvn` merges them
# across the arms and the loop body, and `licm` computes `a * b` once.
N = 1000000
a = 1.0001
b = 0.9999
x = 1.0
y = 0.5
total = 0
for i in range(N):
    if x * y + a * b > 1.2:
        s = sqrt(a * b + x * y) * 0.5 + x * y
    else:
        s = sqrt(a * b + x * y) * 0.25 - x * y
    total = total + s + (x * y + a * b) * 0.001
    x = x * 0.9999 + (a * b - x * y) * 0.0001
    y = y * 0.9999 + s * 0.0001
print(total, x, y)
