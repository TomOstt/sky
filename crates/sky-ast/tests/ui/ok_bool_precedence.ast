(= p (not (< a b)))
(= q (and (< a b) (< b c)))
(= r (not (not x)))
(= s (or (and a b) c))
(= t (or a (and b c)))
(= u (and a b c))
(= v (or a b c))
(= w (or (and (not a) b) (not c)))
(= y (not (paren (and a b))))
(= z (call f (not a) (or b c)))
(= k (or (attr x and) (attr x not)))
(= m (neg (paren (not x))))
