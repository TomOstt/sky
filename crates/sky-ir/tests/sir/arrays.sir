// Array values: literals, subscripts, the builtins, and arithmetic on
// arrays (which the scalar operations already cover).
sir edition 2026

fn @literals(%i: num[1; ()], %q: unknown) -> (num[L; (3)], num[1; (2, 2)], num[L; ()], num[L; (2)], num[1; ()]) {
  %a = const.float 1 : num[L; ()]
  %b = const.float 2 : num[L; ()]
  %c = const.float 3 : num[L; ()]
  %v = array.literal %a, %b, %c : num[L; (3)] @ 10..22
  %one = const.float 1 : num[1; ()]
  %two = const.float 2 : num[1; ()]
  %three = const.float 3 : num[1; ()]
  %four = const.float 4 : num[1; ()]
  %m = array.literal[2] %one, %two, %three, %four : num[1; (2, 2)] @ 30..50
  %r = array.literal[3] %one, %two, %three : num[1; (1, 3)] @ 51..58
  %u = array.literal[2] %a, %q : unknown @ 59..66
  %x = index %v, %i : num[L; ()] @ 60..64
  %lo = const.float 1 : num[1; ()]
  %s = slice[lo:] %v, %lo : num[L; (2)] @ 70..76
  %n = len %m : num[1; ()] @ 80..86
  return %v, %m, %x, %s, %n
}

fn @subscripts(%A: num[1; (3, 4)], %i: num[1; ()], %j: num[1; ()]) -> (num[1; ()], num[1; (4)], num[1; (3)], num[1; (2, 2)], num[1; (2, 4)]) {
  %e = index %A, %i, %j : num[1; ()] @ 1..2
  %row = index %A, %i : num[1; (4)] @ 3..4
  %col = slice[:, at] %A, %j : num[1; (3)] @ 5..6
  %block = slice[lo:hi, lo:hi] %A, %i, %j, %i, %j : num[1; (2, 2)] @ 7..8
  %top = slice[:hi] %A, %i : num[1; (2, 4)] @ 9..10
  return %e, %row, %col, %block, %top
}

fn @builders() -> (num[1; (3)], num[1; (2, 3)], num[1; (3, 3); {Symmetric, PositiveDefinite, Diagonal, Orthogonal}]) {
  %n = const.float 3 : num[1; ()]
  %m = const.float 2 : num[1; ()]
  %z = zeros %n : num[1; (3)] @ 1..2
  %zz = zeros %m, %n : num[1; (2, 3)] @ 3..4
  %eye = identity %n : num[1; (3, 3); {Symmetric, PositiveDefinite, Diagonal, Orthogonal}] @ 5..6
  return %z, %zz, %eye
}

fn @arithmetic(%K: num[M·T⁻²; (2, 2); {Symmetric, PositiveDefinite}], %f: num[L·M·T⁻²; (2)]) -> (num[L; (2)], num[L; (2)], num[L·M·T⁻²; (2)]) {
  %u = solve[cholesky] %K, %f : num[L; (2)] @ 1..2
  %inv = inverse %K : num[M⁻¹·T²; (2, 2); {Symmetric, PositiveDefinite}] @ 3..4
  %v = matmul %inv, %f : num[L; (2)] @ 5..6
  %two = const.float 2 : num[1; ()]
  %w = mul %two, %f : num[L·M·T⁻²; (2)] @ 7..8
  return %u, %v, %w
}
