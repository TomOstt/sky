// A x = b with A positive definite: the form the Cholesky pass produces,
// next to the explicit inverse it replaces.
sir edition 2026

fn @solve_it(%A: num[M·T⁻²; (N#0, N#0); {Symmetric, PositiveDefinite}], %b: num[L·M·T⁻²; (N#0)]) -> (num[L; (N#0)], num[L; (N#0)]) {
  %x = solve[cholesky] %A, %b : num[L; (N#0)] @ 20..40
  %inv = inverse %A : num[M⁻¹·T²; (N#0, N#0); {Symmetric, PositiveDefinite}] @ 44..50
  %y = matmul %inv, %b : num[L; (N#0)] @ 44..60
  return %x, %y
}

fn @transposed(%M: num[1; (3, 4)]) -> (num[1; (4, 3)], num[1; (3, 3)]) {
  %t = transpose %M : num[1; (4, 3)]
  %g = matmul %M, %t : num[1; (3, 3)]
  return %t, %g
}
