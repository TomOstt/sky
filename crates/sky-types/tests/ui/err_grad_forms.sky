# What `grad(f)` accepts: a `def` with annotated scalar parameters and a
# scalar result, called where it is written.
def loose(x, y: m) -> m:
    return y

def norm(v: Vector[3] m) -> m:
    return v[0]

def path(t: s) -> Vector[3] m:
    return [t * 1 m/s, 1 m, 2 m]

def constant() -> m:
    return 1 m

def position(t: s) -> m:
    return 5 m/s^2 * t^2

a = grad(loose)(1 m, 2 m)
b = grad(norm)([1 m, 2 m, 3 m])
d = grad(path)(1 s)
e = grad(sqrt)(4)
f = grad(position, t)(1 s)
g = grad()(1 s)
h = grad(constant)()
i = grad(position)
j = grad(derivative(position, t))(1 s)
k = derivative(grad(position), t)(1 s)
l = grad(position)(1 m)
n = grad(position)(1 s, 2 s)
o = grad(3 m)(1 m)
