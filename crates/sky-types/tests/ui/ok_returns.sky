# Every path returns; recursion; a function with no value at all.
def sign(x):
    if x > 0 m:
        return 1
    elif x < 0 m:
        return 0 - 1
    else:
        return 0

def forever():
    while true:
        return 1

def fact(n):
    if n < 1:
        return 1
    return n * fact(n - 1)

def shout():
    pass

def inferred() -> Vector[3]:
    v: Vector[3]
    return v

a = sign(3 m)
b = fact(3)
c = shout()
d = inferred() @ inferred()
