# Scaling by a scalar keeps Symmetric and Diagonal and drops
# PositiveDefinite and Orthogonal; negation also keeps Orthogonal.
# env: A: Matrix[3,3] PositiveDefinite
# env: Q: Matrix[3,3] Orthogonal
# env: D: Matrix[3,3] Diagonal
two_a = 2 * A
a_three = A * 3
two_q = 2 * Q
d_half = D / 2
neg_a = -A
neg_q = -Q
