# Double pendulum (chaotic): two equal masses on two rigid rods.
#
# Equations of motion from the Lagrangian, written as an `equation`; the
# total energy is declared conserved and the solver monitors its drift.
# Angles are measured from the downward vertical.

m1 = 1 kg
m2 = 1 kg
L1 = 1 m
L2 = 1 m

equation dpend(t: s):
    th1: rad
    th2: rad
    w1: rad/s
    w2: rad/s
    d = th1 - th2
    den = 2 * m1 + m2 - m2 * cos(2 * d)
    th1' = w1
    th2' = w2
    w1' = (-g_n * (2 * m1 + m2) * sin(th1) - m2 * g_n * sin(th1 - 2 * th2) - 2 * sin(d) * m2 * (w2^2 * L2 + w1^2 * L1 * cos(d))) / (L1 * den)
    w2' = (2 * sin(d) * (w1^2 * L1 * (m1 + m2) + g_n * (m1 + m2) * cos(th1) + w2^2 * L2 * m2 * cos(d))) / (L2 * den)

sol = solve dpend from 0 s to 20 s with th1 = 2.0 rad, th2 = 2.5 rad, w1 = 0 rad/s, w2 = 0 rad/s:
    tolerance 1e-10
    conserve energy = 0.5 * m1 * L1^2 * w1^2 + 0.5 * m2 * (L1^2 * w1^2 + L2^2 * w2^2 + 2 * L1 * L2 * w1 * w2 * cos(th1 - th2)) - (m1 + m2) * g_n * L1 * cos(th1) - m2 * g_n * L2 * cos(th2) within 1e-8

print("angles at t = 20 s:", sol.th1, sol.th2)
print("velocities:", sol.w1, sol.w2)
print("energy:", sol.energy)
print(explain(sol))
