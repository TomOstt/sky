# Double pendulum with an uncertain initial angle.
#
# `solve` refuses `±` initial values ("`solve` does not propagate uncertainties
# yet"), so the propagation is done by hand: solve at theta1 and theta1 + eps,
# take the finite-difference sensitivity d(theta1(T))/d(theta1(0)), and attach
# sigma * |sensitivity| as the uncertainty with `±`. This is first-order
# propagation: exactly what Sky's `±` does for ordinary formulas. For a chaotic
# system the sensitivity grows exponentially, so the linear estimate stops
# meaning anything after a few seconds; the program shows where.

m1 = 1 kg
m2 = 1 kg
L1 = 1 m
L2 = 1 m

equation dpend(t: s):
    th1: rad
    th2: rad
    w1: rad/s
    w2: rad/s
    d = th1 - th2
    den = 2 * m1 + m2 - m2 * cos(2 * d)
    th1' = w1
    th2' = w2
    w1' = (-g_n * (2 * m1 + m2) * sin(th1) - m2 * g_n * sin(th1 - 2 * th2) - 2 * sin(d) * m2 * (w2^2 * L2 + w1^2 * L1 * cos(d))) / (L1 * den)
    w2' = (2 * sin(d) * (w1^2 * L1 * (m1 + m2) + g_n * (m1 + m2) * cos(th1) + w2^2 * L2 * m2 * cos(d))) / (L2 * den)

# theta1 at time T for an initial theta1 = a
def theta1_at(a: rad, T: s) -> rad:
    sol = solve dpend from 0 s to T with th1 = a, th2 = 2.5 rad, w1 = 0 rad/s, w2 = 0 rad/s:
        tolerance 1e-11
    return sol.th1

a0 = 2.0 ± 0.01 rad
eps = 1e-6 rad

for T in [1 s, 2 s, 4 s, 6 s, 8 s, 10 s]:
    y0 = theta1_at(nominal(a0), T)
    sens = (theta1_at(nominal(a0) + eps, T) - y0) / eps
    y = y0 ± abs(sens) * uncertainty(a0)
    print("T =", T, " theta1 =", y, " sensitivity =", sens)
