# Figure-eight three-body orbit again, with the bodies as the rows of one
# Matrix[3, 2] of positions and one of velocities (a more natural layout than
# six separate variables, and one that would extend to N bodies, if only
# the force on every body could be built in a loop: arrays are immutable and
# there is no stack/concatenate, so `pull` below has to spell out each row).
#
# Short span (0.2 s) so it is quick; see figure8.sky for the full period.

Gs = 1 m^3/kg/s^2
mb = 1 kg

# Acceleration of the body at position a due to a body at position b.
def pull(a: Vector[2] m, b: Vector[2] m) -> Vector[2] m/s^2:
    return Gs * mb * (b - a) / norm(b - a)^3

def accel(r: Matrix[3, 2] m) -> Matrix[3, 2] m/s^2:
    a0 = pull(r[0], r[1]) + pull(r[0], r[2])
    a1 = pull(r[1], r[0]) + pull(r[1], r[2])
    a2 = pull(r[2], r[0]) + pull(r[2], r[1])
    return [[a0[0], a0[1]], [a1[0], a1[1]], [a2[0], a2[1]]]      # no way to stack three vectors into a matrix

equation fig8(t: s):
    r: Matrix[3, 2] m
    v: Matrix[3, 2] m/s
    r' = v
    v' = accel(r)

r0 = [[0.97000436 m, -0.24308753 m], [-0.97000436 m, 0.24308753 m], [0 m, 0 m]]
v0 = [[0.466203685 m/s, 0.432365730 m/s], [0.466203685 m/s, 0.432365730 m/s], [-0.93240737 m/s, -0.86473146 m/s]]

def energy(r: Matrix[3, 2] m, v: Matrix[3, 2] m/s) -> J:
    return 0.5 * mb * (norm(v[0])^2 + norm(v[1])^2 + norm(v[2])^2) - Gs * mb^2 * (1 / norm(r[0] - r[1]) + 1 / norm(r[0] - r[2]) + 1 / norm(r[1] - r[2]))

sol = solve fig8 from 0 s to 0.2 s with r = r0, v = v0:
    tolerance 1e-9
    conserve E = energy(r, v)

print(sol.r)
print(sol.E)
print(explain(sol))
