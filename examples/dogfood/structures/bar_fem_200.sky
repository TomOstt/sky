# 1D finite-element bar, 200 elements (dogfood: structures).
#
# Same physics as bar_fem.sky (steel bar, fixed at x = 0, axial load F at the
# tip) with 200 elements. The assembled matrix cannot be written as a
# 200 x 200 literal, so the PositiveDefinite proof (literals only, up to
# 32 x 32) is out of reach; `trust_pd` below is the workaround we found: the
# call site is not checked against a tagged parameter, but the Cholesky solve
# verifies the promise when it runs.

E = 200 GPa
A = 1 cm^2
L = 2 m
F = 1 kN
Le = L / 200
k = E * A / Le
ke = k * [[1, -1], [-1, 1]]

def assemble(ke: Matrix[2, 2] N/m) -> Matrix[201, 201] N/m:
    K = 0 N/m * zeros(201, 201)
    for e in range(200):
        P = identity(201)[e:e+2, :]
        K = K + Pᵀ @ ke @ P
    return K

# Not checked at the call site: any matrix is accepted, and it is verified
# (symmetry, positive pivots) when the Cholesky factorization runs.
def trust_pd(K: PositiveDefinite Matrix[N, N] N/m) -> PositiveDefinite Matrix[N, N] N/m:
    return K

K = assemble(ke)
Kr = trust_pd(K[1:201, 1:201])        # fixed end: drop row/column 0
f = F * identity(200)[199]            # load on the last node
u = Kr⁻¹ @ f                          # Cholesky: 200^3/3 flops

print("tip displacement:", u[199] as mm)
print("exact F L/(E A): ", F * L / (E * A) as mm)

err = 0 m
for i in range(200):
    err = max(err, abs(u[i] - F * ((i + 1) * Le) / (E * A)))
print("max nodal error: ", err)
assert err < 1e-9 m
