sir edition 2026

fn @<main>() -> () effects(io, fail) @ 0..430 {
  %A = input "A" : num[1; (500, 500)] @ 303..322
  %B = input "B" : num[1; (500, 500)] @ 323..342
  %C = input "C" : num[1; (500, 500)] @ 343..362
  %v = input "v" : num[1; (500)] @ 363..377
  %4 = matmul %C, %v : num[1; (500)] @ 390..395 (390..391, 394..395)
  %5 = matmul %B, %4 : num[1; (500)] @ 386..395 (386..387, 390..395)
  %x = matmul %A, %5 : num[1; (500)] @ 382..395 (382..383, 386..395)
  %7 = matmul %A, %B : num[1; (500, 500)] @ 402..407 (402..403, 406..407)
  %8 = matmul %7, %C : num[1; (500, 500)] @ 401..412 (401..408, 411..412)
  %y = matmul %8, %v : num[1; (500)] @ 400..417 (400..413, 416..417)
  print %x, %y @ 418..429
  return @ 0..430
}
