fn @<main>() -> () effects(io, fail) @ 0..438 {
  %A = input "A" : num[1; (N#0, N#0)] @ 305..320
  %B = input "B" : num[1; (N#0, N#0)] @ 321..336
  %v = input "v" : num[1; (N#0)] @ 337..349
  %3 = matmul %B, %v : num[1; (N#0)] @ 358..363 (358..359, 362..363)
  %x = matmul %A, %3 : num[1; (N#0)] @ 354..363 (354..355, 358..363)
  %P = input "P" : num[1; (N#0, M#1)] @ 364..379
  %Q = input "Q" : num[1; (M#1, K#2)] @ 380..395
  %R = input "R" : num[1; (K#2, K#2)] @ 396..411
  %8 = matmul %A, %P : num[1; (N#0, M#1)] @ 416..421 (416..417, 420..421)
  %y = matmul %8, %Q : num[1; (N#0, K#2)] @ 416..425 (416..421, 424..425)
  print %x, %y @ 426..437
  return @ 0..438
}
