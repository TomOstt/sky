sir edition 2026

fn @<main>(%A: num[1; (3, 3); {Symmetric, PositiveDefinite}], %b: num[1; (3)]) -> () effects(io, fail) @ 0..314 {
  %B = inverse %A : num[1; (3, 3); {Symmetric, PositiveDefinite}] @ 285..291
  %x = solve[cholesky] %A, %b : num[1; (3)] @ 285..301
  print %x, %B @ 302..313
  return @ 0..314
}
