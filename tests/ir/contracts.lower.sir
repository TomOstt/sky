sir edition 2026

fn @<main>() -> () effects(io, fail, call) @ 0..401 {
  %0 = const.float 20 : num[L; ()] @ 278..282
  %1 = call @fall_time(%0) : num[T; ()] @ 268..283
  %2 = const.float 5 : num[L; ()] @ 296..299
  %3 = call @fall_time(%2) : num[T; ()] @ 286..300
  %t = add %1, %3 : num[T; ()] @ 268..300
  %5 = const.float 0 : num[T; ()] @ 312..315
  %6 = cmp.gt %t, %5 : bool @ 308..315
  assert[assert] "t > 0 s" msg "time passes" names("t") %6, %t @ 308..315
  %7 = const.float 2 : num[L; ()] @ 338..341
  %8 = const.float 1 : num[L; ()] @ 344..347
  %9 = cmp.gt %7, %8 : bool @ 338..347
  assert[assert] "2 m > 1 m" %9 @ 338..347
  %10 = const.float 3 : num[L; ()] @ 358..361
  %11 = const.float 2 : num[L; ()] @ 363..366
  %k = call @ratio(%10, %11) : num[L; ()] @ 352..367
  %13 = const.float 1 : num[L; ()] @ 395..398
  %14 = add %k, %13 : num[L; ()] @ 391..398
  %15 = call @open_ended(%14) : num[L; ()] @ 380..399
  print %t, %k, %15 @ 368..400
  return @ 0..401
}

fn @fall_time(%h: num[L; ()]) -> (num[T; ()]) effects(fail) @ 0..101 {
  %1 = const.float 0 : num[L; ()] @ 44..47
  %2 = cmp.ge %h, %1 : bool @ 39..47
  assert[requires] "h >= 0 m" fn "fall_time" names("h") %2, %h @ 39..47
  %3 = const.float 2 : num[1; ()] @ 89..90
  %4 = mul %3, %h : num[L; ()] @ 89..94
  %5 = const.float 9.80665 : num[L·T⁻²; ()] @ 97..100
  %6 = div %4, %5 : num[T²; ()] @ 89..100
  %7 = math.sqrt %6 : num[T; ()] @ 84..101
  %8 = const.float 0 : num[T; ()] @ 69..72
  %9 = cmp.gt %7, %8 : bool @ 60..72
  assert[ensures] "result > 0 s" fn "fall_time" names("result") %9, %7 @ 60..72
  return %7 @ 0..101
}

fn @ratio(%a: num[L; ()], %b: num[L; ()]) -> (num[L; ()]) effects(fail) @ 103..200 {
  %2 = const.float 0 : num[L; ()] @ 149..152
  %3 = cmp.ne %b, %2 : bool @ 144..152
  %4 = if %3 : bool {
    ^1:
      %5 = const.float 0 : num[L; ()] @ 161..164
      %6 = cmp.gt %a, %5 : bool @ 157..164
      yield %6 @ 144..164
  } {
    ^2:
      %7 = const.bool false : bool @ 144..164
      yield %7 @ 144..164
  } @ 144..164
  assert[requires] "b != 0 m and a > 0 m" fn "ratio" msg "b divides a" names("b", "a") %4, %b, %a @ 144..164
  %8 = mul %a, %a : num[L²; ()] @ 191..196
  %9 = div %8, %b : num[L; ()] @ 191..200
  return %9 @ 103..200
}

fn @open_ended(%x: num[L; ()]) -> (num[L; ()]) effects(fail) @ 202..262 {
  %1 = const.float 1 : num[L; ()] @ 246..249
  %2 = cmp.gt %x, %1 : bool @ 242..249
  assert[requires] "x > 1 m" fn "open_ended" names("x") %2, %x @ 242..249
  return %x @ 202..262
}
