sir edition 2026

fn @<main>() -> () effects(io, fail, call) @ 0..401 {
  %0 = call @"fall_time[h=20]"() : num[T; ()] @ 268..283
  %1 = call @"fall_time[h=5]"() : num[T; ()] @ 286..300
  %t = add %0, %1 : num[T; ()] @ 268..300 (268..283, 286..300)
  %3 = const.float 0 : num[T; ()] @ 312..315
  %4 = cmp.gt %t, %3 : bool @ 308..315 (308..309, 312..315)
  assert[assert] "t > 0 s" msg "time passes" names("t") %4, %t @ 308..315
  %5 = const.float 1 : num[L; ()] @ 344..347
  %k = call @"ratio[a=3,b=2]"() : num[L; ()] @ 352..367
  %7 = add %k, %5 : num[L; ()] @ 391..398 (391..392, 395..398)
  %8 = call @open_ended(%7) : num[L; ()] @ 380..399
  print %t, %k, %8 @ 368..400
  return @ 0..401
}

fn @open_ended(%x: num[L; ()]) -> (num[L; ()]) effects(fail) @ 202..262 {
  %1 = const.float 1 : num[L; ()] @ 246..249
  %2 = cmp.gt %x, %1 : bool @ 242..249 (242..243, 246..249)
  assert[requires] "x > 1 m" fn "open_ended" names("x") %2, %x @ 242..249
  return %x @ 202..262
}

fn @"fall_time[h=20]"() -> (num[T; ()]) effects(fail) @ 0..101 {
  %0 = const.float 4.078864851911713 : num[T²; ()] @ 89..100
  %1 = math.sqrt %0 : num[T; ()] @ 84..101 (89..100)
  return %1 @ 0..101
}

fn @"fall_time[h=5]"() -> (num[T; ()]) effects(fail) @ 0..101 {
  %0 = const.float 1.0197162129779282 : num[T²; ()] @ 89..100
  %1 = math.sqrt %0 : num[T; ()] @ 84..101 (89..100)
  return %1 @ 0..101
}

fn @"ratio[a=3,b=2]"() -> (num[L; ()]) effects(fail) @ 103..200 {
  %0 = const.float 4.5 : num[L; ()] @ 191..200
  return %0 @ 103..200
}
