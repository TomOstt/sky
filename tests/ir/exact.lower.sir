sir edition 2026

fn @<main>() -> () effects(io, fail, call) @ 0..455 {
  %0 = const.float 2 : num[1; ()] @ 344..345
  %root = math.sqrt %0 : num[1; ()] @ 339..346 (344..345)
  %2 = const.float 3 : num[1; ()] @ 358..359
  %3 = math.sqrt %2 : num[1; ()] @ 353..360 (358..359)
  %4 = const.float 3 : num[1; ()] @ 368..369
  %5 = math.sqrt %4 : num[1; ()] @ 363..370 (368..369)
  %gap = sub %3, %5 : num[1; ()] @ 353..370 (353..360, 363..370)
  %7 = const.float 5 : num[1; ()] @ 384..385
  %8 = math.sqrt %7 : num[1; ()] @ 379..386 (384..385)
  %9 = const.float 5 : num[1; ()] @ 394..395
  %10 = math.sqrt %9 : num[1; ()] @ 389..396 (394..395)
  %ratio = div %8, %10 : num[1; ()] @ 379..396 (379..386, 389..396)
  %12 = const.float 3 : num[L; ()] @ 409..412
  %13 = call @halve(%12) : num[L; ()] @ 403..413
  print %13, %gap, %ratio @ 397..426
  %14 = const.float 1 : num[1; ()] @ 433..434
  %15 = const.float 3 : num[1; ()] @ 435..436
  %16 = div %14, %15 : num[1; ()] @ 433..436 (433..434, 435..436)
  %17 = const.float 1 : num[1; ()] @ 439..440
  %18 = const.float 6 : num[1; ()] @ 441..442
  %19 = div %17, %18 : num[1; ()] @ 439..442 (439..440, 441..442)
  %20 = add %16, %19 : num[1; ()] @ 433..442 (433..436, 439..442)
  %21 = const.float 0.1 : num[1; ()] @ 444..447
  %22 = const.float 0.2 : num[1; ()] @ 450..453
  %23 = add %21, %22 : num[1; ()] @ 444..453 (444..447, 450..453)
  print %20, %23 @ 427..454
  return @ 0..455
}

fn @halve(%x: num[L; ()]) -> (num[L; ()]) effects(fail) @ 272..330 {
  %1 = const.float 2 : num[1; ()] @ 310..311
  %spare = div %x, %1 : num[L; ()] @ 306..311 (306..307, 310..311)
  %3 = const.float 0.5 : num[1; ()] @ 327..330
  %4 = mul %x, %3 : num[L; ()] @ 323..330 (323..324, 327..330)
  return %4 @ 272..330
}
