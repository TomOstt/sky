sir edition 2026

fn @<main>() -> () effects(io, fail, call) @ 0..455 {
  %gap = const.float 0 : num[1; ()] @ 353..370
  %ratio = const.float 1 : num[1; ()] @ 379..396
  %2 = call @"halve[x=3]"() : num[L; ()] @ 403..413
  print %2, %gap, %ratio @ 397..426
  %3 = const.float 0.5 : num[1; ()] @ 433..442
  %4 = const.float 0.30000000000000004 : num[1; ()] @ 444..453
  print %3, %4 @ 427..454
  return @ 0..455
}

fn @"halve[x=3]"() -> (num[L; ()]) effects(fail) @ 272..330 {
  %0 = const.float 1.5 : num[L; ()] @ 323..330
  return %0 @ 272..330
}
