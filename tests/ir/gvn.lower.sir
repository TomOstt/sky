  %5 = cmp.gt %cond, %4 : bool @ 591..599 (591..595, 598..599)
  if %5 {
    ^1:
      %b = mul %y, %x : num[1; ()] @ 609..614 (609..610, 613..614)
      print %b @ 619..627
      yield @ 588..650
  } {
    ^2:
      %7 = const.float 2 : num[1; ()] @ 648..649
      %8 = mul %x, %7 : num[1; ()] @ 644..649 (644..645, 648..649)
      print %8 @ 638..650
      yield @ 588..650
  } @ 588..650
  %9 = mul %x, %y : num[1; ()] @ 657..662 (657..658, 661..662)
  %10 = add %9, %a : num[1; ()] @ 657..666 (657..662, 665..666)
  print %10 @ 651..667
  %q = div %x, %y : num[1; ()] @ 672..677 (672..673, 676..677)
  %12 = sub %x, %y : num[1; ()] @ 684..689 (684..685, 688..689)
  %13 = sub %y, %x : num[1; ()] @ 691..696 (691..692, 695..696)
  print %12, %13 @ 678..697
  %14 = div %x, %y : num[1; ()] @ 704..709 (704..705, 708..709)
  %15 = add %14, %q : num[1; ()] @ 704..713 (704..709, 712..713)
