sir edition 2026

fn @<main>() -> () effects(io, fail) @ 0..512 {
  %K = input "K" : num[1; (2, 2)] @ 366..381
  %A = input "A" : num[1; (2, 2)] @ 382..397
  %steps = input "steps" : num[1; ()] @ 398..411
  %3 = const.float 1 : num[1; ()] @ 417..418
  %4 = const.float 2 : num[1; ()] @ 420..421
  %u = array.literal %3, %4 : num[1; (2)] @ 416..422 (417..418, 420..421)
  %i = const.float 0 : num[1; ()] @ 427..428
  %i_1, %u_1 = while %i, %u : num[1; ()], num[1; (2)] {
    ^1(%i_2: num[1; ()], %u_2: num[1; (2)]):
      %11 = cmp.lt %i_2, %steps : bool @ 435..444 (435..436, 439..444)
      condition %11, %i_2, %u_2 @ 435..444
  } {
    ^2(%i_3: num[1; ()], %u_3: num[1; (2)]):
      %Kinv = inverse %K : num[1; (2, 2)] @ 457..463 (461..462)
      %15 = matmul %Kinv, %u_3 : num[1; (2)] @ 472..480 (472..476, 479..480)
      %16 = transpose %A : num[1; (2, 2)] @ 483..487
      %17 = matmul %16, %u_3 : num[1; (2)] @ 483..491 (483..487, 490..491)
      %u_4 = add %15, %17 : num[1; (2)] @ 472..491 (472..480, 483..491)
      %19 = const.float 1 : num[1; ()] @ 501..502
      %i_4 = add %i_3, %19 : num[1; ()] @ 496..502 (496..497, 501..502)
      yield %i_4, %u_4 @ 429..502
  } @ 429..502
  print %u_1 @ 503..511
  return @ 0..512
}
