fn @<main>() -> () effects(io, fail) @ 0..421 {
  %d = input "d" : num[1; ()] @ 322..331
  %i = const.float 0 : num[1; ()] @ 336..337
  %total = const.float 0 : num[1; ()] @ 346..347
  %i_1, %total_1 = while %i, %total : num[1; ()], num[1; ()] {
    ^1(%i_2: num[1; ()], %total_2: num[1; ()]):
      %7 = const.float 3 : num[1; ()] @ 358..359
      %8 = cmp.lt %i_2, %7 : bool @ 354..359 (354..355, 358..359)
      condition %8, %i_2, %total_2 @ 354..359
  } {
    ^2(%i_3: num[1; ()], %total_3: num[1; ()]):
      %11 = const.float 1 : num[1; ()] @ 369..370
      %t = div %11, %d : num[1; ()] @ 369..374 (369..370, 373..374)
      %total_4 = add %total_3, %t : num[1; ()] @ 387..396 (387..392, 395..396)
      %14 = const.float 1 : num[1; ()] @ 406..407
      %i_4 = add %i_3, %14 : num[1; ()] @ 401..407 (401..402, 406..407)
