sir edition 2026

fn @<main>() -> () effects(io, fail, call) @ 0..586 {
  %0 = const.float 1000000 : num[1; ()] @ 454..461
  %a = zeros %0 : num[1; (1000000)] @ 448..462 (454..461)
  %2 = const.float 2 : num[1; ()] @ 496..497
  %d = fused %a, %2 : num[1; (1000000)] {
    ^1(%4: num[1; ()], %5: num[1; ()]):
      %6 = add %4, %4 : num[1; ()] @ 487..492 (487..488, 491..492)
      %7 = mul %6, %5 : num[1; ()] @ 486..497 (486..493, 496..497)
      %8 = sub %7, %4 : num[1; ()] @ 486..501 (486..497, 500..501)
      yield %8 @ 486..501
  } @ 486..501 (487..488, 496..497)
  %9 = const.float 1000 : num[1; ()] @ 511..515
  %x = call @work(%9) : num[1; ()] @ 506..516
  %11 = const.float 2000 : num[1; ()] @ 526..530
  %y = call @work(%11) : num[1; ()] @ 521..531
  %13 = const.float 1 : num[1; ()] @ 542..543
  %p = call @noisy(%13) : unknown @ 536..544
  %15 = const.float 3000 : num[1; ()] @ 554..558
  %q = call @work(%15) : num[1; ()] @ 549..559
  %17 = const.float 10 : num[1; ()] @ 568..570
  %18 = index %d, %17 : num[1; ()] @ 566..571 (566..567, 568..570)
  %19 = add %x, %y : num[1; ()] @ 573..578 (573..574, 577..578)
  print %18, %19, %p, %q @ 560..585
  return @ 0..586
}

fn @"work[n:Scalar]"(%n: num[1; ()]) -> (num[1; ()]) effects(fail) @ 263..397 {
  %total = const.float 0 : num[1; ()] @ 288..289
  %2 = const.float 1 : num[1; ()] @ 350..351
  %i, %total_1 = while %total, %total : num[1; ()], num[1; ()] {
    ^1(%i_1: num[1; ()], %total_2: num[1; ()]):
      %7 = cmp.lt %i_1, %n : bool @ 310..315 (310..311, 314..315)
      condition %7, %i_1, %total_2 @ 310..315
  } {
    ^2(%i_2: num[1; ()], %total_3: num[1; ()]):
      %10 = add %i_2, %2 : num[1; ()] @ 346..351 (346..347, 350..351)
      %11 = math.sqrt %10 : num[1; ()] @ 341..352 (346..351)
      %12 = div %11, %10 : num[1; ()] @ 341..362 (341..352, 355..362)
      %total_4 = add %total_3, %12 : num[1; ()] @ 333..362 (333..338, 341..362)
      yield %10, %total_4 @ 304..380
  } @ 304..380
  return %total_1 @ 263..397
}

fn @"noisy[n:Scalar]"(%n: num[1; ()]) -> (num[1; ()]) effects(io, fail) @ 399..442 {
  print %n @ 417..425
  %1 = const.float 2 : num[1; ()] @ 441..442
  %2 = mul %n, %1 : num[1; ()] @ 437..442 (437..438, 441..442)
  return %2 @ 399..442
}
