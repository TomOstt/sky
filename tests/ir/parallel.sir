sir edition 2026

fn @<main>() -> () effects(io, fail, call) @ 0..586 {
  %0 = const.float 1000000 : num[1; ()] @ 454..461
  %a = zeros %0 : num[1; (1000000)] @ 448..462 (454..461)
  %2 = const.float 1000000 : num[1; ()] @ 473..480
  %b = zeros %2 : num[1; (1000000)] @ 467..481 (473..480)
  %4 = const.float 2 : num[1; ()] @ 496..497
  %d = fused %a, %b, %4 : num[1; (1000000)] {
    ^1(%6: num[1; ()], %7: num[1; ()], %8: num[1; ()]):
      %9 = add %6, %7 : num[1; ()] @ 487..492 (487..488, 491..492)
      %10 = mul %9, %8 : num[1; ()] @ 486..497 (486..493, 496..497)
      %11 = sub %10, %6 : num[1; ()] @ 486..501 (486..497, 500..501)
      yield %11 @ 486..501
  } @ 486..501 (487..488, 491..492, 496..497)
  %12 = const.float 1000 : num[1; ()] @ 511..515
  %x = call @work(%12) : num[1; ()] @ 506..516
  %14 = const.float 2000 : num[1; ()] @ 526..530
  %y = call @work(%14) : num[1; ()] @ 521..531
  %16 = const.float 1 : num[1; ()] @ 542..543
  %p = call @noisy(%16) : unknown @ 536..544
  %18 = const.float 3000 : num[1; ()] @ 554..558
  %q = call @work(%18) : num[1; ()] @ 549..559
  %20 = const.float 10 : num[1; ()] @ 568..570
  %21 = index %d, %20 : num[1; ()] @ 566..571 (566..567, 568..570)
  %22 = add %x, %y : num[1; ()] @ 573..578 (573..574, 577..578)
  print %21, %22, %p, %q @ 560..585
  return @ 0..586
}

fn @work(%n: unknown) -> (num[1; ()]) effects(fail) @ 263..397 {
  %total = const.float 0 : num[1; ()] @ 288..289
  %i = const.float 0 : num[1; ()] @ 298..299
  %i_1, %total_1 = while %i, %total : num[1; ()], num[1; ()] {
    ^1(%i_2: num[1; ()], %total_2: num[1; ()]):
      %7 = cmp.lt %i_2, %n : bool @ 310..315 (310..311, 314..315)
      condition %7, %i_2, %total_2 @ 310..315
  } {
    ^2(%i_3: num[1; ()], %total_3: num[1; ()]):
      %10 = const.float 1 : num[1; ()] @ 350..351
      %11 = add %i_3, %10 : num[1; ()] @ 346..351 (346..347, 350..351)
      %12 = math.sqrt %11 : num[1; ()] @ 341..352 (346..351)
      %13 = const.float 1 : num[1; ()] @ 360..361
      %14 = add %i_3, %13 : num[1; ()] @ 356..361 (356..357, 360..361)
      %15 = div %12, %14 : num[1; ()] @ 341..362 (341..352, 355..362)
      %total_4 = add %total_3, %15 : num[1; ()] @ 333..362 (333..338, 341..362)
      %17 = const.float 1 : num[1; ()] @ 379..380
      %i_4 = add %i_3, %17 : num[1; ()] @ 375..380 (375..376, 379..380)
      yield %i_4, %total_4 @ 304..380
  } @ 304..380
  return %total_1 @ 263..397
}

fn @noisy(%n: unknown) -> (unknown) effects(io, fail) @ 399..442 {
  print %n @ 417..425
  %1 = const.float 2 : num[1; ()] @ 441..442
  %2 = mul %n, %1 : unknown @ 437..442 (437..438, 441..442)
  return %2 @ 399..442
}
