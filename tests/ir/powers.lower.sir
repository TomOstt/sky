sir edition 2026

fn @<main>() -> () effects(io, fail, call) @ 0..550 {
  %0 = const.float 2 : num[1; ()] @ 527..528
  %1 = call @powers(%0) : num[1; ()] @ 520..529
  print %1 @ 514..530
  %2 = const.float 3 : num[L; ()] @ 544..547
  %3 = call @volume(%2) : num[L³; ()] @ 537..548
  print %3 @ 531..549
  return @ 0..550
}

fn @powers(%x: num[1; ()]) -> (num[1; ()]) effects(fail) @ 292..476 {
  %p2 = pow.const[2] %x : num[1; ()] @ 324..329 (324..325)
  %p5 = pow.const[5] %x : num[1; ()] @ 339..344 (339..340)
  %p14 = pow.const[14] %x : num[1; ()] @ 355..361 (355..356)
  %p15 = pow.const[15] %x : num[1; ()] @ 372..378 (372..373)
  %inverse_cube = pow.const[-3] %x : num[1; ()] @ 398..404 (398..399)
  %root = pow.const[1/2] %x : num[1; ()] @ 416..423 (416..417)
  %7 = add %p2, %p5 : num[1; ()] @ 435..442 (435..437, 440..442)
  %8 = add %7, %p14 : num[1; ()] @ 435..448 (435..442, 445..448)
  %9 = add %8, %p15 : num[1; ()] @ 435..454 (435..448, 451..454)
  %10 = add %9, %inverse_cube : num[1; ()] @ 435..469 (435..454, 457..469)
  %11 = add %10, %root : num[1; ()] @ 435..476 (435..469, 472..476)
  return %11 @ 292..476
}

fn @volume(%l: num[L; ()]) -> (num[L³; ()]) effects(fail) @ 478..512 {
  %1 = pow.const[3] %l : num[L³; ()] @ 507..512 (507..508)
  return %1 @ 478..512
}
