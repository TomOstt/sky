fn @<main>() -> () effects(io, fail) @ 0..697 {
  %A = input "A" : num[1; (100, 100)] @ 368..387
  %B = input "B" : num[1; (100, 100)] @ 388..407
  %D = input "D" : num[1; (100, 100); {Symmetric, Diagonal}] @ 408..436
