  %b = input "b" : num[1; (100)] @ 505..519
  %lu = solve[lu] %A, %b : num[1; (100)] @ 525..535 (525..526, 534..535)
  %right = solve.right[lu] %b, %A : num[1; (100)] @ 544..554 (544..545, 552..553)
