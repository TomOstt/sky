}

fn @fact(%n: num[1; ()]) -> (unknown) effects(fail, call) @ 342..431 {
  %1 = const.bool false : bool @ 342..431
  %2 = const.nothing : nothing @ 342..431
  %3 = const.float 1 : num[1; ()] @ 385..386
  %4 = cmp.le %n, %3 : bool @ 380..386 (380..381, 385..386)
  %5, %6 = if %4 : bool, unknown {
    ^1:
      %7 = const.float 1 : num[1; ()] @ 403..404
      %8 = const.bool true : bool @ 396..404
      yield %8, %7 @ 377..404
  } {
    ^2:
      yield %1, %2 @ 377..404
  } @ 377..404
  %9 = not %5 : bool @ 409..431
  %10, %11 = if %9 : bool, unknown {
    ^3:
