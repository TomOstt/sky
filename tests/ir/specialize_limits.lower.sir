      %14 = call @fact(%13) : unknown @ 420..431
      %15 = mul %n, %14 : unknown @ 416..431 (416..417, 420..431)
      %16 = const.bool true : bool @ 409..431
      yield %16, %15 @ 409..431
  } {
    ^4:
      yield %5, %6 @ 409..431
  } @ 409..431
  return %11 @ 342..431
}
