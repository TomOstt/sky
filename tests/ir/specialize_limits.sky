# A function gets at most 8 specializations (`sky_opt::specialize`): the
# ninth constant keeps calling the generic `k`, and the note says why. A
# recursion on a constant, `fact(5)`, makes one clone per value and stops at
# the base case, so the recursion is unrolled into a chain of calls.
def k(x: Scalar) -> Scalar:
    return x * 2 + 1

def fact(n: Scalar) -> Scalar:
    if n <= 1:
        return 1
    return n * fact(n - 1)

print(k(1), k(2), k(3), k(4), k(5))
print(k(6), k(7), k(8), k(9), k(10))
print(fact(5))
