sir edition 2026

fn @<main>() -> () effects(io, fail, call) @ 0..503 {
  %z = input "z" : num[1; ()] @ 321..330
  %1 = math.abs %z : num[1; ()] @ 459..465 (463..464)
  %2 = const.float 1 : num[1; ()] @ 468..469
  %3 = add %1, %2 : num[1; ()] @ 459..469 (459..465, 468..469)
  %4 = call @g(%3) : num[1; ()] @ 457..470
  %5 = const.float 1 : num[1; ()] @ 475..476
  %6 = neg %5 : num[1; ()] @ 474..476 (475..476)
  %7 = math.abs %z : num[1; ()] @ 479..485 (483..484)
  %8 = sub %6, %7 : num[1; ()] @ 474..485 (474..476, 479..485)
  %9 = call @g(%8) : num[1; ()] @ 472..486
  %10 = math.abs %z : num[1; ()] @ 490..496 (494..495)
  %11 = const.float 1 : num[1; ()] @ 499..500
  %12 = add %10, %11 : num[1; ()] @ 490..500 (490..496, 499..500)
  %13 = call @h(%12) : num[1; ()] @ 488..501
  print %4, %9, %13 @ 451..502
  return @ 0..503
}

fn @g(%x: num[1; ()]) -> (num[1; ()]) @ 332..403 {
  %1 = const.bool false : bool @ 332..403
  %2 = const.float 0 : num[1; ()] @ 332..403
  %3 = const.float 0 : num[1; ()] @ 371..372
  %4 = cmp.gt %x, %3 : bool @ 367..372 (367..368, 371..372)
  %5, %6 = if %4 : bool, num[1; ()] {
    ^1:
      %7 = const.float 1 : num[1; ()] @ 389..390
      %8 = const.bool true : bool @ 382..390
      yield %8, %7 @ 364..390
  } {
    ^2:
      yield %1, %2 @ 364..390
  } @ 364..390
  %9 = not %5 : bool @ 395..403
  %10, %11 = if %9 : bool, num[1; ()] {
    ^3:
      %12 = const.float 2 : num[1; ()] @ 402..403
      %13 = const.bool true : bool @ 395..403
      yield %13, %12 @ 395..403
  } {
    ^4:
      yield %5, %6 @ 395..403
  } @ 395..403
  return %11 @ 332..403
}

fn @h(%x: num[1; ()]) -> (num[1; ()]) effects(fail) @ 405..449 {
  %1 = const.float 2 : num[1; ()] @ 448..449
  %2 = mul %x, %1 : num[1; ()] @ 444..449 (444..445, 448..449)
  return %2 @ 405..449
}
