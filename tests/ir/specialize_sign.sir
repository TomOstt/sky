sir edition 2026

fn @<main>() -> () effects(io, fail, call) @ 0..503 {
  %z = input "z" : num[1; ()] @ 321..330
  %1 = math.abs %z : num[1; ()] @ 459..465 (463..464)
  %2 = const.float 1 : num[1; ()] @ 468..469
  %3 = add %1, %2 : num[1; ()] @ 459..469 (459..465, 468..469)
  %4 = call @"g[x>0]"(%3) : num[1; ()] @ 457..470
  %5 = const.float -1 : num[1; ()] @ 474..476
  %6 = sub %5, %1 : num[1; ()] @ 474..485 (474..476, 479..485)
  %7 = call @"g[x<0]"(%6) : num[1; ()] @ 472..486
  %8 = call @h(%3) : num[1; ()] @ 488..501
  print %4, %7, %8 @ 451..502
  return @ 0..503
}

fn @h(%x: num[1; ()]) -> (num[1; ()]) effects(fail) @ 405..449 {
  %1 = const.float 2 : num[1; ()] @ 448..449
  %2 = mul %x, %1 : num[1; ()] @ 444..449 (444..445, 448..449)
  return %2 @ 405..449
}

fn @"g[x>0]"(%x: num[1; ()]) -> (num[1; ()]) @ 332..403 {
  %1 = const.float 1 : num[1; ()] @ 389..390
  return %1 @ 332..403
}

fn @"g[x<0]"(%x: num[1; ()]) -> (num[1; ()]) @ 332..403 {
  %1 = const.float 2 : num[1; ()] @ 402..403
  return %1 @ 332..403
}
