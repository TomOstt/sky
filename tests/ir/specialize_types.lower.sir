sir edition 2026

fn @<main>() -> () effects(io, fail, call) @ 0..777 {
  %0 = const.float 10 : num[1; ()] @ 727..729
  %1 = call @fib(%0) : unknown @ 723..730
  %2 = const.float 3 : num[1; ()] @ 735..736
  %3 = call @sq(%2) : unknown @ 732..737
  %4 = const.float 3 : num[L; ()] @ 742..745
  %5 = call @sq(%4) : unknown @ 739..746
  %6 = const.float 2 : num[1; ()] @ 754..755
  %7 = call @twice(%6) : unknown @ 748..756
  print %1, %3, %5, %7 @ 717..757
  %8 = const.bool true : bool @ 770..774
  %9 = call @twice(%8) : unknown @ 764..775
  print %9 @ 758..776
  return @ 0..777
}

fn @fib(%n: unknown) -> (unknown) effects(fail, call) @ 577..654 {
  %1 = const.bool false : bool @ 577..654
  %2 = const.nothing : nothing @ 577..654
  %3 = const.float 2 : num[1; ()] @ 600..601
  %4 = cmp.lt %n, %3 : bool @ 596..601 (596..597, 600..601)
  %5, %6 = if %4 : bool, unknown {
    ^1:
      %7 = const.bool true : bool @ 611..619
      yield %7, %n @ 593..619
  } {
    ^2:
      yield %1, %2 @ 593..619
  } @ 593..619
  %8 = not %5 : bool @ 624..654
  %9, %10 = if %8 : bool, unknown {
    ^3:
      %11 = const.float 1 : num[1; ()] @ 639..640
      %12 = sub %n, %11 : unknown @ 635..640 (635..636, 639..640)
      %13 = call @fib(%12) : unknown @ 631..641
      %14 = const.float 2 : num[1; ()] @ 652..653
      %15 = sub %n, %14 : unknown @ 648..653 (648..649, 652..653)
      %16 = call @fib(%15) : unknown @ 644..654
      %17 = add %13, %16 : unknown @ 631..654 (631..641, 644..654)
      %18 = const.bool true : bool @ 624..654
      yield %18, %17 @ 624..654
  } {
    ^4:
      yield %5, %6 @ 624..654
  } @ 624..654
  return %10 @ 577..654
}

fn @sq(%x: unknown) -> (unknown) effects(fail) @ 656..683 {
  %1 = mul %x, %x : unknown @ 678..683 (678..679, 682..683)
  return %1 @ 656..683
}

fn @twice(%x: unknown) -> (unknown) effects(fail) @ 685..715 {
  %1 = add %x, %x : unknown @ 710..715 (710..711, 714..715)
  return %1 @ 685..715
}
