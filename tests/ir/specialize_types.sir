sir edition 2026

fn @<main>() -> () effects(io, fail, call) @ 0..777 {
  %0 = const.float 10 : num[1; ()] @ 727..729
  %1 = call @"fib[n:Scalar]"(%0) : num[1; ()] @ 723..730
  %2 = const.float 3 : num[1; ()] @ 735..736
  %3 = call @"sq[x:Scalar]"(%2) : num[1; ()] @ 732..737
  %4 = const.float 3 : num[L; ()] @ 742..745
  %5 = call @"sq[x:Scalar(length)]"(%4) : num[L²; ()] @ 739..746
  %6 = const.float 2 : num[1; ()] @ 754..755
  %7 = call @"twice[x:Scalar]"(%6) : num[1; ()] @ 748..756
  print %1, %3, %5, %7 @ 717..757
  %8 = const.bool true : bool @ 770..774
  %9 = call @twice(%8) : unknown @ 764..775
  print %9 @ 758..776
  return @ 0..777
}

fn @twice(%x: unknown) -> (unknown) effects(fail) @ 685..715 {
  %1 = add %x, %x : unknown @ 710..715 (710..711, 714..715)
  return %1 @ 685..715
}

fn @"fib[n:Scalar]"(%n: num[1; ()]) -> (num[1; ()]) effects(fail, call) @ 577..654 {
  %1 = const.bool false : bool @ 577..654
  %2 = const.float 2 : num[1; ()] @ 600..601
  %3 = cmp.lt %n, %2 : bool @ 596..601 (596..597, 600..601)
  %4, %5 = if %3 : bool, num[1; ()] {
    ^1:
      %6 = const.bool true : bool @ 611..619
      yield %6, %n @ 593..619
  } {
    ^2:
      %7 = const.float 0 : num[1; ()] @ 593..619
      yield %1, %7 @ 593..619
  } @ 593..619
  %8 = not %4 : bool @ 624..654
  %9, %10 = if %8 : bool, num[1; ()] {
    ^3:
      %11 = const.float 1 : num[1; ()] @ 639..640
      %12 = sub %n, %11 : num[1; ()] @ 635..640 (635..636, 639..640)
      %13 = call @"fib[n:Scalar]"(%12) : num[1; ()] @ 631..641
      %14 = sub %n, %2 : num[1; ()] @ 648..653 (648..649, 652..653)
      %15 = call @"fib[n:Scalar]"(%14) : num[1; ()] @ 644..654
      %16 = add %13, %15 : num[1; ()] @ 631..654 (631..641, 644..654)
      %17 = const.bool true : bool @ 624..654
      yield %17, %16 @ 624..654
  } {
    ^4:
      yield %4, %5 @ 624..654
  } @ 624..654
  return %10 @ 577..654
}

fn @"sq[x:Scalar]"(%x: num[1; ()]) -> (num[1; ()]) effects(fail) @ 656..683 {
  %1 = mul %x, %x : num[1; ()] @ 678..683 (678..679, 682..683)
  return %1 @ 656..683
}

fn @"sq[x:Scalar(length)]"(%x: num[L; ()]) -> (num[L²; ()]) effects(fail) @ 656..683 {
  %1 = mul %x, %x : num[L²; ()] @ 678..683 (678..679, 682..683)
  return %1 @ 656..683
}

fn @"twice[x:Scalar]"(%x: num[1; ()]) -> (num[1; ()]) effects(fail) @ 685..715 {
  %1 = add %x, %x : num[1; ()] @ 710..715 (710..711, 714..715)
  return %1 @ 685..715
}
