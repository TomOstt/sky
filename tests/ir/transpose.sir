sir edition 2026

fn @<main>() -> () effects(io, fail) @ 0..149 {
  %0 = const.float 1 : num[1; ()] @ 68..69
  %1 = const.float 2 : num[1; ()] @ 71..72
  %2 = const.float 3 : num[1; ()] @ 74..75
  %3 = const.float 4 : num[1; ()] @ 79..80
  %4 = const.float 5 : num[1; ()] @ 82..83
  %5 = const.float 6 : num[1; ()] @ 85..86
  %A = array.literal[3] %0, %1, %2, %3, %4, %5 : num[1; (2, 3)] @ 66..88 (68..69, 71..72, 74..75, 79..80, 82..83, 85..86)
  %7 = transpose %A : num[1; (3, 2)] @ 96..100
  %gram = matmul %7, %A : num[1; (3, 3)] @ 96..104 (96..100, 103..104)
  %same = transpose %A : num[1; (3, 2)] @ 112..124
  print %gram @ 125..136
  print %same @ 137..148
  return @ 0..149
}
