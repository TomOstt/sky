# Performance contracts that the static cost model proves false.
def mm(A: Matrix[N, K], B: Matrix[K, M]) -> Matrix[N, M]:
    cost flops <= 2 * N^3
    return A @ B

def step(v: Vector[N], w: Vector[N]) -> Vector[N]:
    cost allocations == 0
    return v + 2 * w

def lower_order(A: Matrix[N, N]) -> Matrix[N, N]:
    cost flops <= 2 * N^2
    return A @ A + A

def loop(v: Vector[N]) -> Vector[N]:
    cost flops <= 1000 * N
    for i in range(len(v)):
        v = v * 2
    return v

def too_few(v: Vector[N]) -> Vector[N]:
    cost flops == 3 * N
    return v * 2
