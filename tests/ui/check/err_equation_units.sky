# The dimension rules of differential equations, end to end.
GM = 1.327e20 m^3/s^2
equation orbit(t: s):
    r: Vector[2] m
    v: Vector[2] m/s
    r' = v
    v' = v

equation partial(t: s):
    x: m
    y: m/s
    x' = y
    z' = 1

sol = solve orbit from 0 to 1 yr with r = [1 AU, 0 m], v = [0 m, 29.8 km/s]:
    tolerance 1 m
    conserve energy = 0.5 * norm(v)
early = solve orbit from 0 s to 1 yr with r = 3 m
missing = solve nope from 0 s to 1 s
shape = solve orbit from 0 s to 1 yr with r = [1 AU, 0 m], v = [0 m/s, 30 km/s]:
    conserve position = r
    conserve r = 0.5 * norm(v)^2
wrong = solve orbit from 0 s to 1 yr with r = [1 m/s, 2 m/s], v = [0 m/s, 1 m/s]:
    conserve kinetic = 0.5 * norm(v)^2 within 1 m
print(sol.q)
