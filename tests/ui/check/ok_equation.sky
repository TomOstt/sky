# Differential equations: an orbit (second order, with a conserved energy)
# and a decay (first order, nothing to conserve).
GM = 1.327e20 m^3/s^2
equation orbit(t: s):
    r: Vector[2] m
    v: Vector[2] m/s
    r' = v
    v' = -GM * r / norm(r)^3

sol = solve orbit from 0 s to 1 yr with r = [1 AU, 0 m], v = [0 m/s, 29.8 km/s]:
    tolerance 1e-9
    conserve energy = 0.5 * norm(v)^2 - GM / norm(r) within 1e-6
distance: m = norm(sol.r)
speed: m/s = norm(sol.v)
e: m^2/s^2 = sol.energy

equation decay(t: s):
    n: Scalar
    k = 0.5 Hz
    n' = -k * n

d = solve decay from 0 s to 4 s with n = 1
left = d.n
